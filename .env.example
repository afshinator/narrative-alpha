# Narrative Alpha — Environment Configuration
# Copy to .env and fill in real values.
# .env is gitignored; .env.example is committed.

# Bright Data
BRIGHTDATA_API_KEY="bd_api_key_from_hackathon"
BRIGHTDATA_SERP_ZONE="serp_zone_name"
BRIGHTDATA_UNLOCKER_ZONE="unlocker_zone_name"
BRIGHTDATA_CUSTOMER_ID="customer_id"

# LLM Provider API Keys (all loaded; active provider via llm_config.json)
DEEPSEEK_API_KEY="sk-deepseek-api-key"
OPENAI_API_KEY="sk-proj-openai-key"
GOOGLE_API_KEY="google-api-key"
GROQ_API_KEY="groq-api-key"

# OpenAI embeddings (fixed — not user-switchable in MVP)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# NARRATIVE_ALPHA_ROOT=/custom/path  # optional — defaults to project root

# Server ports (all optional)
# BACKEND_PORT=8000        # uvicorn listen port
# VITE_BACKEND_PORT=8000   # frontend proxy target (defaults to BACKEND_PORT)
# PORT=5173                # Vite listen port — set to a port your client can reach